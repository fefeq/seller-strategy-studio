+describe("upsert_product", () => {
+  it("is limited to the roles that may price, and only queues a confirmation", () => {
+    const t = getTool("upsert_product")!;
+    expect(t.kind).toBe("write");
+    for (const r of ["owner", "sales_leader", "deal_desk"]) expect(canUseTool(t, [r])).toBe(true);
+    for (const r of ["ae", "sdr", "marketing"]) expect(canUseTool(t, [r])).toBe(false);
+  });
+
+  it("creates a product inside the company, after checking the name is free", async () => {
+    const { db, log } = fakeDb((q) => (q.op === "insert" ? { data: { id: ID(70) } } : { data: [] }));
+    await executeTool(ctxWith(db, ["owner"]), "upsert_product", { name: "Plan Pro", price: 99, billing: "monthly" });
+    expect(writes(log, "products")[0].payload).toMatchObject({ name: "Plan Pro", price: 99, billing: "monthly", org_id: ORG });
+    expectScoped(log);
+  });
+
+  it("refuses a name that already exists and points to the existing product", async () => {
+    const { db, log } = fakeDb(() => ({ data: [{ id: ID(71), name: "Plan Pro" }] }));
+    await expect(executeTool(ctxWith(db, ["owner"]), "upsert_product", { name: "plan pro", price: 99 })).rejects.toThrow(new RegExp(ID(71)));
+    expect(writes(log)).toHaveLength(0);
+  });
+
+  it("needs a name and a price to create, and a change to update", async () => {
+    const { db } = fakeDb(() => ({ data: [] }));
+    await expect(executeTool(ctxWith(db, ["owner"]), "upsert_product", { price: 5 })).rejects.toThrow(/nombre/);
+    await expect(executeTool(ctxWith(db, ["owner"]), "upsert_product", { name: "X" })).rejects.toThrow(/precio/);
+    const one = fakeDb(() => ({ data: [{ id: ID(72), name: "Existente" }] }));
+    await expect(executeTool(ctxWith(one.db, ["owner"]), "upsert_product", { product_id: ID(72) })).rejects.toThrow(/qué cambiar/);
+  });
+
+  it("updates only the fields given, scoped to the company, and checks the product is theirs", async () => {
+    const { db, log } = fakeDb(() => ({ data: [{ id: ID(72), name: "Existente" }] }));
+    await executeTool(ctxWith(db, ["deal_desk"]), "upsert_product", { product_id: ID(72), price: 120, active: false });
+    const upd = writes(log, "products")[0];
+    expect(upd.op).toBe("update");
+    expect(upd.payload).toEqual({ price: 120, active: false });
+    expect(eq(upd, "id", ID(72))).toBe(true);
+    expectScoped(log);
+    const none = fakeDb(() => ({ data: null }));
+    await expect(executeTool(ctxWith(none.db, ["owner"]), "upsert_product", { product_id: ID(73), price: 1 })).rejects.toThrow(/No encuentro ese producto/);
+  });
+
+  it("renaming to another product's name is refused, renaming to its own name is fine", async () => {
+    const { db } = fakeDb(() => ({ data: [{ id: ID(72), name: "Plan A" }, { id: ID(73), name: "Plan B" }] }));
+    await expect(executeTool(ctxWith(db, ["owner"]), "upsert_product", { product_id: ID(72), name: " plan b " })).rejects.toThrow(/Elige otro nombre/);
+    await expect(executeTool(ctxWith(db, ["owner"]), "upsert_product", { product_id: ID(72), name: "PLAN A" })).resolves.toBeDefined();
+  });
+
