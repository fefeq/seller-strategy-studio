@@ -0,0 +1,41 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type { ToolCtx } from "@/lib/agent/tool-kit";
+
+const state = { connection: null as { last_synced_at: string | null } | null, synced: [] as string[], eqs: [] as unknown[][], result: { ok: true } as { ok: boolean; error?: string } };
+vi.mock("@/integrations/supabase/client.server", () => ({
+  supabaseAdmin: { from: () => ({ select: () => ({ eq: (...a: unknown[]) => { state.eqs.push(a); return { maybeSingle: async () => ({ data: state.connection }) }; } }) }) },
+}));
+vi.mock("@/lib/stripe/sync.server", () => ({
+  MANUAL_SYNC_MINUTES: 2,
+  syncStripeOrg: async (_db: unknown, orgId: string) => { state.synced.push(orgId); return state.result; },
+}));
+
+import { ADMIN_WRITE_TOOLS } from "./admin-writes";
+const tool = ADMIN_WRITE_TOOLS.find((t) => t.name === "sync_stripe_now")!;
+const ctx = { db: {}, orgId: "org-1", userId: "u", roles: ["owner"], currency: "EUR" } as unknown as ToolCtx;
+
+describe("sync_stripe_now", () => {
+  beforeEach(() => { state.connection = null; state.synced = []; state.eqs = []; state.result = { ok: true }; });
+
+  it("only leaders may use it, and it is a confirmed write", () => {
+    expect(tool.kind).toBe("write");
+    expect(tool.roles).toEqual(["owner", "sales_leader"]);
+  });
+  it("says so when Stripe is not connected and reads nothing", async () => {
+    await expect(tool.run(ctx, {})).rejects.toThrow(/no está conectado/);
+    expect(state.synced).toEqual([]);
+  });
+  it("does not hammer Stripe: a read from the last two minutes is refused", async () => {
+    state.connection = { last_synced_at: new Date(Date.now() - 30_000).toISOString() };
+    await expect(tool.run(ctx, {})).rejects.toThrow(/menos de 2 minutos/);
+    expect(state.synced).toEqual([]);
+  });
+  it("syncs only the caller's company when allowed, and surfaces a Stripe error", async () => {
+    state.connection = { last_synced_at: new Date(Date.now() - 10 * 60_000).toISOString() };
+    await tool.run(ctx, {});
+    expect(state.synced).toEqual(["org-1"]);
+    expect(state.eqs).toEqual([["org_id", "org-1"]]); // the connection read is the caller's company's
+    state.result = { ok: false, error: "Clave no válida" };
+    await expect(tool.run(ctx, {})).rejects.toThrow("Clave no válida");
+  });
+});
