@@ -0,0 +1,63 @@
+// Writes the chat was missing for setup work: the product catalogue and the Stripe re-read.
+// Both only queue a confirmation (kind "write"); the person approves in Sugerencias.
+import { z } from "zod";
+import { BILLING_LABELS } from "@/lib/deal-lines";
+import { canPrice, def, defined, ok, type AgentTool } from "../tool-kit";
+
+const PRICING_ROLES = ["owner", "sales_leader", "deal_desk"] as const;
+
+export const ADMIN_WRITE_TOOLS: AgentTool[] = [
+  def({
+    name: "upsert_product", kind: "write", roles: [...PRICING_ROLES],
+    description: "Crea un producto del catálogo o, si pasas product_id, cambia el que ya existe (nombre, precio, coste, cobro, activo). Precio y coste son por periodo de cobro (monthly, annual, one_off). Para desactivar un producto usa active=false: no se borra. Mira antes list_products para no duplicar.",
+    input: z.object({
+      product_id: z.string().uuid().optional().describe("Si se pasa, actualiza ese producto"),
+      name: z.string().trim().min(1).max(120).optional(),
+      price: z.number().min(0).max(100_000_000).optional(),
+      cost: z.number().min(0).max(100_000_000).nullable().optional().describe("null borra el coste"),
+      billing: z.enum(Object.keys(BILLING_LABELS) as [string, ...string[]]).optional(),
+      active: z.boolean().optional(),
+      description: z.string().max(1000).optional(),
+      sku: z.string().trim().max(60).nullable().optional(),
+    }),
+    summarize: (a) => a.product_id
+      ? `Actualizar un producto: ${[a.name ? `nombre «${a.name}»` : "", a.price != null ? `precio ${a.price}` : "", a.cost !== undefined ? (a.cost === null ? "quitar el coste" : `coste ${a.cost}`) : "", a.billing ? `cobro ${BILLING_LABELS[a.billing as keyof typeof BILLING_LABELS]}` : "", a.active === false ? "desactivarlo" : a.active === true ? "activarlo" : ""].filter(Boolean).join(", ") || "sin cambios indicados"}`
+      : `Crear el producto «${a.name ?? "sin nombre"}»${a.price != null ? ` a ${a.price}` : ""}${a.billing ? ` (${BILLING_LABELS[a.billing as keyof typeof BILLING_LABELS]})` : ""}`,
+    run: async (c, a) => {
+      // Who may set prices is also enforced by the database, but Telegram and cron use a client that skips it.
+      if (!canPrice(c.roles)) throw new Error("Solo Owner, Sales Leader o Deal Desk pueden cambiar el catálogo.");
+      const { product_id, ...fields } = a;
+      const patch = defined(fields);
+      // Exact, case-insensitive comparison in code: a * or % typed in a name must not act as a wildcard.
+      const names = ok(await c.db.from("products").select("id,name").eq("org_id", c.orgId).limit(2000)) ?? [];
+      const clash = a.name ? names.find((p) => p.id !== product_id && p.name.trim().toLowerCase() === a.name!.trim().toLowerCase()) : undefined;
+      if (clash) throw new Error(`Ya hay un producto llamado «${clash.name}». ${product_id ? "Elige otro nombre." : `Para cambiarlo pasa product_id (${clash.id}).`}`);
+      if (product_id) {
+        if (!names.some((p) => p.id === product_id)) throw new Error("No encuentro ese producto en esta empresa. Búscalo primero con list_products.");
+        if (!Object.keys(patch).length) throw new Error("No has indicado qué cambiar del producto.");
+        return ok(await c.db.from("products").update(patch).eq("org_id", c.orgId).eq("id", product_id).select("id").single());
+      }
+      if (!a.name) throw new Error("Falta el nombre del producto.");
+      if (a.price == null) throw new Error("Falta el precio del producto (por periodo de cobro).");
+      if (!a.billing) throw new Error("Falta el cobro del producto: monthly (mensual), annual (anual) u one_off (pago único). El precio es por ese periodo.");
+      return ok(await c.db.from("products").insert({ ...patch, name: a.name, price: a.price, billing: a.billing, org_id: c.orgId }).select("id").single());
+    },
+  }),
+  def({
+    name: "sync_stripe_now", kind: "write", roles: ["owner", "sales_leader"],
+    description: "Vuelve a leer Stripe ahora (clientes, MRR, altas y bajas). No más de una vez cada pocos minutos; si Stripe no está conectado lo dice.",
+    input: z.object({}),
+    summarize: () => "Leer Stripe ahora",
+    run: async (c) => {
+      const { supabaseAdmin } = await import("@/integrations/supabase/client.server");
+      const { syncStripeOrg, MANUAL_SYNC_MINUTES } = await import("@/lib/stripe/sync.server");
+      const { data: conn } = await supabaseAdmin.from("stripe_connections").select("last_synced_at").eq("org_id", c.orgId).maybeSingle();
+      if (!conn) throw new Error("Stripe no está conectado en esta empresa. Conéctalo en Conexiones.");
+      if (conn.last_synced_at && Date.now() - new Date(conn.last_synced_at).getTime() < MANUAL_SYNC_MINUTES * 60_000)
+        throw new Error(`Stripe se ha leído hace menos de ${MANUAL_SYNC_MINUTES} minutos. Espera un poco antes de volver a leerlo.`);
+      const r = await syncStripeOrg(supabaseAdmin, c.orgId);
+      if (!r.ok) throw new Error(r.error ?? "Stripe no ha respondido.");
+      return { mensaje: "Stripe leído. Consulta get_stripe_metrics para ver las cifras actualizadas." };
+    },
+  }),
+];
