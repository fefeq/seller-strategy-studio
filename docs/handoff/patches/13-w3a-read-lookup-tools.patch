index 0000000..a41056f
--- /dev/null
+++ b/src/lib/agent/tools/lookups.ts
@@ -0,0 +1,76 @@
+// Read-only lookups the chat needed to answer simple questions without sending the person to a screen:
+// segments, team, self-service trials and links. Every query scopes org_id (these also run on Telegram
+// with the privileged client, where RLS does not apply).
+import { z } from "zod";
+import { NAV } from "@/lib/nav";
+import { SITE_URL } from "@/lib/site";
+import { def, isLeader, mustFind, ok, type AgentTool } from "../tool-kit";
+
+const plain = (s: string) => s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().trim();
+const num = (v: unknown) => (v == null ? null : Number(v));
+
+export const LOOKUP_TOOLS: AgentTool[] = [
+  def({
+    name: "list_segments", kind: "read",
+    description: "Segmentos de la empresa en orden de prioridad: rango de ACV, modelo de venta, win rate objetivo, cuota anual por AE, CAC y payback objetivo. Úsalo antes de crear o editar un segmento o al recomendar a qué segmento va una cuenta.",
+    input: z.object({}),
+    run: async (c) => {
+      const rows = ok(await c.db.from("segments").select("id,name,motion,priority,acv_min,acv_max,win_rate_target,ae_quota,cac_target,payback_months,gross_margin_pct,cycle_days,notes").eq("org_id", c.orgId).order("priority", { ascending: true, nullsFirst: false }).order("acv_min", { ascending: true }));
+      return (rows ?? []).map((s) => ({
+        id: s.id, nombre: s.name, modelo: s.motion, prioridad: s.priority, acv_min: num(s.acv_min), acv_max: num(s.acv_max), win_rate_objetivo_pct: num(s.win_rate_target),
+        cuota_anual_ae: num(s.ae_quota), cac_objetivo: num(s.cac_target), payback_objetivo_meses: num(s.payback_months), margen_bruto_pct: num(s.gross_margin_pct), ciclo_dias: num(s.cycle_days), nota: s.notes,
+      }));
+    },
+  }),
+  def({
+    name: "list_members", kind: "read",
+    description: "Personas del equipo de esta empresa y su rol (owner, sales_leader, ae, sdr, deal_desk, marketing…). Los emails solo los ven Owner y Sales Leader. Úsalo para saber a quién asignar algo.",
+    input: z.object({}),
+    run: async (c) => {
+      const members = ok(await c.db.from("org_members").select("user_id,role,created_at").eq("org_id", c.orgId).order("created_at"));
+      const ids = [...new Set((members ?? []).map((m) => m.user_id))];
+      // Profiles are read by the ids of this company's members only, never by a wide query.
+      const profiles = ids.length ? ok(await c.db.from("profiles").select("id,full_name,email").in("id", ids)) : [];
+      const byId = new Map((profiles ?? []).map((p) => [p.id, p]));
+      const leader = isLeader(c.roles);
+      // A person with two roles is one person with two roles, not two rows.
+      const roles = new Map<string, string[]>();
+      for (const m of members ?? []) roles.set(m.user_id, [...(roles.get(m.user_id) ?? []), m.role]);
+      return [...roles].map(([id, rs]) => ({ user_id: id, nombre: byId.get(id)?.full_name || null, rol: rs.join(", "), ...(leader ? { email: byId.get(id)?.email ?? null } : {}), eres_tu: id === c.userId }));
+    },
+  }),
+  def({
+    name: "list_trials", kind: "read",
+    description: "Altas self-service (pruebas): email, empresa, plan, fecha de alta, activación y pago. Filtra por estado: pending (sin activar), activated (activadas sin pagar) o converted (de pago). Más recientes primero.",
+    input: z.object({ status: z.enum(["pending", "activated", "converted"]).optional(), limit: z.number().int().min(1).max(50).optional() }),
+    run: async (c, a) => {
+      let q = c.db.from("trials").select("id,email,company,plan,mrr,signed_up_at,activated_at,converted_at,source").eq("org_id", c.orgId).order("signed_up_at", { ascending: false }).limit(a.limit ?? 20);
+      if (a.status === "pending") q = q.is("activated_at", null).is("converted_at", null);
+      if (a.status === "activated") q = q.not("activated_at", "is", null).is("converted_at", null);
+      if (a.status === "converted") q = q.not("converted_at", "is", null);
+      const rows = ok(await q);
+      return (rows ?? []).map((t) => ({
+        id: t.id, email: t.email, empresa: t.company, plan: t.plan, mrr: num(t.mrr), alta: t.signed_up_at, origen: t.source,
+        estado: t.converted_at ? "de pago" : t.activated_at ? "activada" : "sin activar", activada: t.activated_at, de_pago: t.converted_at,
+      }));
+    },
+  }),
+  def({
+    name: "get_link", kind: "read",
+    description: "Enlace directo a una pantalla de Nokko por su nombre («Pipeline», «Equipo», «Conexiones»…) o a la ficha de una cuenta (account_id). Úsalo cuando la persona quiera ver o hacer algo que solo se hace en pantalla.",
+    input: z.object({ page: z.string().min(2).max(60).optional().describe("Nombre de la pantalla tal como se ve en el menú"), account_id: z.string().uuid().optional() }),
+    run: async (c, a) => {
+      const base = process.env["APP_URL"] || SITE_URL;
+      if (a.account_id) {
+        const acc = await mustFind<{ id: string; name: string }>(c, "accounts", a.account_id, "esa cuenta", "id,name");
+        return { pantalla: acc.name, enlace: `${base}/accounts/${acc.id}` };
+      }
+      if (!a.page) throw new Error("Dime a qué pantalla quieres ir o pasa account_id.");
+      const want = plain(a.page);
+      const items = NAV.filter((i) => !i.leadersOnly || isLeader(c.roles));
+      const hit = items.find((i) => plain(i.label) === want) ?? items.find((i) => plain(i.label).includes(want) || want.includes(plain(i.label)) || plain(i.keywords ?? "").split(" ").includes(want));
+      if (!hit) throw new Error(`No conozco la pantalla «${a.page}». Pantallas: ${items.map((i) => i.label).join(", ")}.`);
+      return { pantalla: hit.label, enlace: `${base}${hit.to}` };
+    },
+  }),
+];
