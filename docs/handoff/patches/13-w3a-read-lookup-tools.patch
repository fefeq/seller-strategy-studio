diff --git a/src/lib/agent-tools.test.ts b/src/lib/agent-tools.test.ts
index 8c27b91..f4231e6 100644
--- a/src/lib/agent-tools.test.ts
+++ b/src/lib/agent-tools.test.ts
@@ -375,3 +375,72 @@ describe("edit, delete, confirm and undo from the agent (SDD field-actions U-5)"
     await expect(executeTool(ctxWith(db, ["owner"]), "undo_change", { change_id: ID(41) })).rejects.toThrow(/pasaron más de 24 horas/);
   });
 });
+
+describe("lookup tools (segments, team, trials, links)", () => {
+  it("list_segments reads only this company's segments and returns plain numbers", async () => {
+    const { db, log } = fakeDb(() => ({ data: [{ id: ID(50), name: "Mid", motion: "inside", priority: 1, acv_min: "5000", acv_max: 50000, win_rate_target: null, ae_quota: 600000, cac_target: null, payback_months: 12, gross_margin_pct: 80, cycle_days: 45, notes: null }] }));
+    const r = (await executeTool(ctxWith(db), "list_segments", {})) as { nombre: string; acv_min: number; win_rate_objetivo_pct: number | null }[];
+    expect(r[0]).toMatchObject({ nombre: "Mid", acv_min: 5000, win_rate_objetivo_pct: null });
+    expectScoped(log);
+  });
+
+  it("list_members asks for profiles only of this company's members and hides emails from non-leaders", async () => {
+    const reply = (q: Q): Reply => q.table === "org_members" ? { data: [{ user_id: ME, role: "ae" }, { user_id: OTHER, role: "owner" }] } : { data: [{ id: ME, full_name: "Ana", email: "ana@example.com" }, { id: OTHER, full_name: "Luis", email: "luis@example.com" }] };
+    const ae = fakeDb(reply);
+    const seenByAe = (await executeTool(ctxWith(ae.db, ["ae"]), "list_members", {})) as Record<string, unknown>[];
+    expect(seenByAe.some((m) => "email" in m)).toBe(false);
+    expect(seenByAe[0]).toMatchObject({ nombre: "Ana", rol: "ae", eres_tu: true });
+    const members = ae.log.find((q) => q.table === "org_members")!;
+    expect(eq(members, "org_id", ORG)).toBe(true);
+    const profiles = ae.log.find((q) => q.table === "profiles")!;
+    expect(profiles.filters.some(([op, col, ids]) => op === "in" && col === "id" && JSON.stringify(ids) === JSON.stringify([ME, OTHER]))).toBe(true);
+    const leader = fakeDb(reply);
+    const seenByLeader = (await executeTool(ctxWith(leader.db, ["sales_leader"]), "list_members", {})) as { email?: string }[];
+    expect(seenByLeader[0].email).toBe("ana@example.com");
+  });
+
+  it("list_members shows a person with two roles once", async () => {
+    const { db } = fakeDb((q) => (q.table === "org_members" ? { data: [{ user_id: ME, role: "ae" }, { user_id: ME, role: "marketing" }] } : { data: [{ id: ME, full_name: "Ana", email: "a@example.com" }] }));
+    const r = (await executeTool(ctxWith(db), "list_members", {})) as { rol: string }[];
+    expect(r).toHaveLength(1);
+    expect(r[0].rol).toBe("ae, marketing");
+  });
+
+  it("list_members does not query profiles when the company has no members", async () => {
+    const { db, log } = fakeDb(() => ({ data: [] }));
+    expect(await executeTool(ctxWith(db), "list_members", {})).toEqual([]);
+    expect(log.map((q) => q.table)).toEqual(["org_members"]);
+  });
+
+  it("list_trials filters by state and stays in the company", async () => {
+    const rows = [{ id: ID(51), email: "a@example.com", company: "Acme", plan: "free", mrr: null, signed_up_at: "2026-10-01", activated_at: "2026-10-02", converted_at: null, source: "web" }];
+    const { db, log } = fakeDb(() => ({ data: rows }));
+    const r = (await executeTool(ctxWith(db), "list_trials", { status: "activated" })) as { estado: string }[];
+    expect(r[0].estado).toBe("activada");
+    expect(log[0].filters).toEqual(expect.arrayContaining([["not", "activated_at", "is", null], ["is", "converted_at", null]]));
+    expectScoped(log);
+  });
+
+  it("get_link builds a link by screen name and respects leaders-only screens", async () => {
+    const { db } = fakeDb();
+    const a = (await executeTool(ctxWith(db), "get_link", { page: "pipeline" })) as { enlace: string };
+    expect(a.enlace).toMatch(/\/deals$/);
+    const b = (await executeTool(ctxWith(db), "get_link", { page: "Equipo" })) as { enlace: string };
+    expect(b.enlace).toMatch(/\/team$/);
+    await expect(executeTool(ctxWith(db, ["ae"]), "get_link", { page: "Asesor GTM" })).rejects.toThrow(/No conozco la pantalla/);
+    expect(((await executeTool(ctxWith(db, ["owner"]), "get_link", { page: "Asesor GTM" })) as { enlace: string }).enlace).toMatch(/\/advisor$/);
+  });
+
+  it("get_link for an account checks it belongs to the company", async () => {
+    const miss = fakeDb(() => ({ data: null }));
+    await expect(executeTool(ctxWith(miss.db), "get_link", { account_id: ID(60) })).rejects.toThrow(/No encuentro esa cuenta/);
+    const hit = fakeDb(() => ({ data: { id: ID(60), name: "Acme" } }));
+    const r = (await executeTool(ctxWith(hit.db), "get_link", { account_id: ID(60) })) as { enlace: string };
+    expect(r.enlace).toMatch(new RegExp(`/accounts/${ID(60)}$`));
+    expectScoped(hit.log);
+  });
+
+  it("are read tools, so they run without confirmation", () => {
+    for (const n of ["list_segments", "list_members", "list_trials", "get_link"]) expect(getTool(n)!.kind).toBe("read");
+  });
+});
