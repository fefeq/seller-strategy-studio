-/** Budget state: warn at 80 %, pause automatic work at 100 %; manual requests are never paused. */
+/** Cap for a company with no org_budgets row (new companies): approximate EUR per month. An owner can change it or clear it. */
+export const DEFAULT_MONTHLY_LIMIT = 25;
+/** Daily cap = this share of the monthly one (5 € of 25 €), so one runaway loop cannot spend the month in an afternoon. */
+export const DAILY_SHARE = 0.2;
+
+/**
+ * Month and day caps together. Warns at 80 % of the month; `paused` when either cap is reached; `remaining` is what
+ * the tightest cap still allows, so manual calls and the agent respect it too. No limit (null or 0) = no caps.
+ */
+export function budgetCaps(spentMonth: number, spentToday: number, limit: number | null) {
+  const month = budgetState(spentMonth, limit);
+  if (!limit || limit <= 0) return { ...month, dailyLimit: null as number | null, spentToday, dailyReached: false };
+  const dailyLimit = Math.round(limit * DAILY_SHARE * 100) / 100;
+  const dailyReached = spentToday >= dailyLimit;
+  const dailyRemaining = Math.max(0, dailyLimit - spentToday);
+  return { ...month, remaining: Math.min(month.remaining, dailyRemaining), paused: month.paused || dailyReached, dailyLimit: dailyLimit as number | null, spentToday, dailyReached };
+}
+
+/** Budget state: warn at 80 %, pause at 100 % (automatic work, and manual requests through trackedRun and the spend guard). */
 export function budgetState(spent: number, limit: number | null) {
   if (!limit || limit <= 0) return { remaining: Infinity, warn: false, paused: false, pct: 0 };
   const pct = spent / limit;
