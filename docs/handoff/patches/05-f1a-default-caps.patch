+// @vitest-environment node
+// Runs migration 0065 (existing companies keep «sin límite») on an in-process Postgres with fictional companies.
+import { beforeAll, describe, expect, it } from "vitest";
+import { build, migrate, seed } from "@/test/pg-harness";
+
+type Db = Awaited<ReturnType<typeof build>>;
+let db: Db;
+let A: string;
+let B: string;
+const rows = async (sql: string, params?: unknown[]) => (await db.query(sql, params)).rows as Record<string, any>[];
+const budget = async (org: string) => (await rows("select monthly_limit from org_budgets where org_id = $1", [org]))[0];
+
+beforeAll(async () => {
+  db = await build();
+  ({ A, B } = await seed(db));
+  await migrate(db, ["0041_orchestrator_budget_usage.sql"]);
+  // Company B's owner already chose a limit.
+  await db.query("insert into org_budgets (org_id, monthly_limit) values ($1, 100)", [B]);
+}, 60_000);
+
+describe("migration 0065: existing companies keep no cap", () => {
+  it("a company with no row gets a row with an empty limit; a chosen limit is untouched", async () => {
+    expect(await budget(A)).toBeUndefined();
+    await migrate(db, ["0065_existing_orgs_keep_no_budget_limit.sql"]);
+    expect(await budget(A)).toMatchObject({ monthly_limit: null });
+    expect(Number((await budget(B))!.monthly_limit)).toBe(100);
+  });
+
+  it("is idempotent, and a company created afterwards has no row (so it gets the default)", async () => {
+    await migrate(db, ["0065_existing_orgs_keep_no_budget_limit.sql"]);
+    expect((await rows("select count(*)::int as n from org_budgets"))[0]!.n).toBe(2);
+    const C = (await rows("insert into organizations (name) values ('Empresa nueva') returning id"))[0]!.id;
+    expect(await budget(C)).toBeUndefined();
+  });
+});
