@@ -0,0 +1,9 @@
+-- F1a gives a company with NO org_budgets row a default cap (25 EUR/month). Companies that already exist keep the
+-- behaviour they have today (no cap): they get an explicit row with an empty limit, which means «sin límite» and is the
+-- owner's to change in Integraciones. Companies created afterwards have no row and start with the default.
+-- Existing rows (a limit the owner already set) are left untouched. Idempotent.
+INSERT INTO public.org_budgets (org_id, monthly_limit)
+SELECT o.id, NULL
+FROM public.organizations o
+WHERE NOT EXISTS (SELECT 1 FROM public.org_budgets b WHERE b.org_id = o.id)
+ON CONFLICT (org_id) DO NOTHING;
