+/** Who gets the follow-up: the lead's owner, else its account's owner, else the company owner. */
+function responsible(s: Parameters<Detector>[0], l: { owner_id: string | null; account_id: string | null }): string | null {
+  if (l.owner_id) return l.owner_id;
+  const accountOwner = l.account_id ? s.accounts.find((a) => a.id === l.account_id)?.owner_id : null;
+  if (accountOwner) return accountOwner;
+  return (s.members ?? []).find((m) => m.role === "owner")?.user_id ?? null;
+}
+
+/** Monday of the week of `d`: keeps a grouped suggestion's key stable for the whole week. */
+function weekKey(d: Date) {
+  const t = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate()));
+  t.setUTCDate(t.getUTCDate() - ((t.getUTCDay() + 6) % 7));
+  return isoDate(t);
+}
