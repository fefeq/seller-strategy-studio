@@ -51,6 +51,32 @@ export type DealOutcome = { id: string; stage: string; closed_at: string | null
 const DAY = 86_400_000;
 const isoDay = (d: Date) => d.toISOString().slice(0, 10);

+/** Business days (Mon–Fri, UTC) elapsed between two instants; Saturdays and Sundays do not count. */
+export function businessDaysBetween(from: Date, to: Date): number {
+  const end = to.getTime();
+  let t = from.getTime();
+  if (end <= t) return 0;
+  let ms = 0;
+  while (t < end) {
+    const dayStart = Math.floor(t / DAY) * DAY;
+    const next = Math.min(end, dayStart + DAY);
+    const dow = new Date(dayStart).getUTCDay();
+    if (dow !== 0 && dow !== 6) ms += next - t;
+    t = next;
+  }
+  return ms / DAY;
+}
+
+/** Company calendar day (YYYY-MM-DD) of an instant; Spain by default so «today» matches what the user sees. */
+export const localIsoDay = (d: Date, timeZone = "Europe/Madrid") => d.toLocaleDateString("sv-SE", { timeZone });
+
+/** The next Mon–Fri day after `d`, as YYYY-MM-DD in the company time zone. */
+export function nextBusinessDay(d: Date, timeZone = "Europe/Madrid"): string {
+  const t = new Date(`${localIsoDay(d, timeZone)}T12:00:00Z`);
+  do { t.setUTCDate(t.getUTCDate() + 1); } while (t.getUTCDay() === 0 || t.getUTCDay() === 6);
+  return isoDay(t);
+}
