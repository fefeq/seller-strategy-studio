+import { describe, expect, it } from "vitest";
+import { ingestLead } from "./leads-ingest";
+import { normalizeLead } from "./leads";
+
+// In-memory stand-in for the few query shapes ingestLead uses (synthetic rows only).
+type Row = Record<string, unknown>;
+function fakeDb() {
+  const t: Record<string, Row[]> = { accounts: [], people: [], leads: [], deals: [] };
+  let n = 0;
+  const rx = (p: string) => new RegExp(`^${p.replace(/\\(.)/g, "\u0000$1").replace(/[.*+?^${}()|[\]]/g, "\\$&").replace(/%/g, ".*").replace(/_/g, ".").replace(/\u0000(.)/g, (_m, c) => c.replace(/[.*+?^${}()|[\]\\%_]/g, "\\$&"))}$`, "i");
+  const from = (name: string) => {
+    const filters: ((r: Row) => boolean)[] = [];
+    let mode: "select" | "update" = "select";
+    let patch: Row = {};
+    const run = () => {
+      const rows = (t[name] ?? []).filter((r) => filters.every((f) => f(r)));
+      if (mode === "update") rows.forEach((r) => Object.assign(r, patch));
+      return rows;
+    };
+    const b: Record<string, unknown> = {
+      select: () => b,
+      eq: (c: string, v: unknown) => (filters.push((r) => r[c] === v), b),
+      is: (c: string, v: unknown) => (filters.push((r) => (r[c] ?? null) === v), b),
+      ilike: (c: string, p: string) => (filters.push((r) => typeof r[c] === "string" && rx(p).test(r[c] as string)), b),
+      filter: (c: string, _op: string, v: string) => (filters.push((r) => v.slice(1, -1).split(",").includes(r[c] as string)), b),
+      not: () => b,
+      order: () => b,
+      limit: () => b,
+      maybeSingle: async () => ({ data: run().at(-1) ?? null, error: null }),
+      single: async () => ({ data: run().at(-1) ?? null, error: null }),
+      update: (p: Row) => ((mode = "update"), (patch = p), b),
+      insert: (r: Row) => {
+        const row = { id: `${name}-${++n}`, linkedin_url: null, created_at: new Date().toISOString(), ...r };
+        t[name].push(row);
+        return { select: () => ({ single: async () => ({ data: row, error: null }) }) };
+      },
+      then: (res: (v: unknown) => unknown) => res({ data: run(), error: null }),
+    };
+    return b;
+  };
+  return { db: { from } as never, t };
+}
+
+const ctx = { orgId: "org-1", segments: [], stages: [] };
+const lead = (rec: Row) => {
+  const r = normalizeLead(rec);
+  if ("error" in r) throw new Error(r.error);
+  return r.lead;
+};
+
+describe("ingestLead with a list that has no emails (synthetic rows)", () => {
+  it("creates the person with profile and title, and the company page on the account", async () => {
+    const { db, t } = fakeDb();
+    await ingestLead(db, ctx, lead({ Nombre: "Ana", Apellidos: "Prueba", Cargo: "Head of Sales", Empresa: "Acme Demo", "URL del perfil": "https://www.linkedin.com/in/ana-prueba", "URL de la empresa": "https://www.linkedin.com/company/acme-demo" }));
+    expect(t.people).toHaveLength(1);
+    expect(t.people[0]).toMatchObject({ full_name: "Ana Prueba", title: "Head of Sales", linkedin_url: "https://www.linkedin.com/in/ana-prueba", account_id: t.accounts[0].id });
+    expect(t.accounts[0].name).toBe("Acme Demo");
+    expect(t.accounts[0].domain).toBeNull();
+    expect(t.accounts[0].linkedin_url).toBe("https://www.linkedin.com/company/acme-demo");
+    expect(t.leads[0]).toMatchObject({ person_id: t.people[0].id, contact_name: "Ana Prueba" });
+  });
+
+  it("a second person at the same company is a second lead, not the first one overwritten", async () => {
+    const { db, t } = fakeDb();
+    const base = { Empresa: "Acme Demo", "URL de la empresa": "https://www.linkedin.com/company/acme-demo" };
+    await ingestLead(db, ctx, lead({ ...base, Nombre: "Ana", Apellidos: "Prueba", Cargo: "CEO", "URL del perfil": "https://www.linkedin.com/in/ana" }));
+    await ingestLead(db, ctx, lead({ ...base, Nombre: "Luis", Apellidos: "Ejemplo", Cargo: "CTO", "URL del perfil": "https://www.linkedin.com/in/luis" }));
+    expect(t.accounts).toHaveLength(1);
+    expect(t.people).toHaveLength(2);
+    expect(t.leads).toHaveLength(2);
+    expect(t.leads.map((l) => l.title).sort()).toEqual(["CEO", "CTO"]);
+  });
+
+  it("importing the same list again updates instead of duplicating", async () => {
+    const { db, t } = fakeDb();
+    const rec = { Empresa: "Acme Demo", Nombre: "Ana", Apellidos: "Prueba", Cargo: "CEO", "URL del perfil": "https://www.linkedin.com/in/ana" };
+    await ingestLead(db, ctx, lead(rec));
+    const again = await ingestLead(db, ctx, lead(rec));
+    expect(again.status).toBe("updated");
+    expect(t.people).toHaveLength(1);
+    expect(t.leads).toHaveLength(1);
+  });
+
+  it("a person without profile is matched by name inside the account", async () => {
+    const { db, t } = fakeDb();
+    await ingestLead(db, ctx, lead({ Empresa: "Acme Demo", Nombre: "Ana", Apellidos: "Prueba" }));
+    await ingestLead(db, ctx, lead({ Empresa: "Acme Demo", Nombre: "Ana", Apellidos: "Prueba", Cargo: "CEO" }));
+    expect(t.people).toHaveLength(1);
+    expect(t.leads).toHaveLength(1);
+  });
+
+  it("keeps a company page that is already there", async () => {
+    const { db, t } = fakeDb();
+    await ingestLead(db, ctx, lead({ Empresa: "Acme Demo", "URL de la empresa": "https://www.linkedin.com/company/acme-demo" }));
+    t.accounts[0].linkedin_url = "https://www.linkedin.com/company/otra";
+    await ingestLead(db, ctx, lead({ Empresa: "Acme Demo", "URL de la empresa": "https://www.linkedin.com/company/acme-demo" }));
+    expect(t.accounts[0].linkedin_url).toBe("https://www.linkedin.com/company/otra");
+  });
+
+  it("two people with the same name but different profiles stay two people", async () => {
+    const { db, t } = fakeDb();
+    const base = { Empresa: "Acme Demo", Nombre: "Juan", Apellidos: "García" };
+    await ingestLead(db, ctx, lead({ ...base, "URL del perfil": "https://www.linkedin.com/in/juan-1" }));
+    await ingestLead(db, ctx, lead({ ...base, "URL del perfil": "https://www.linkedin.com/in/juan-2" }));
+    expect(t.people).toHaveLength(2);
+    expect(t.leads).toHaveLength(2);
+  });
+
+  it("names match without caring about accents or case", async () => {
+    const { db, t } = fakeDb();
+    await ingestLead(db, ctx, lead({ Empresa: "Acme Demo", Nombre: "José", Apellidos: "García" }));
+    await ingestLead(db, ctx, lead({ Empresa: "Acme Demo", Nombre: "jose", Apellidos: "garcia" }));
+    expect(t.people).toHaveLength(1);
+    expect(t.leads).toHaveLength(1);
+  });
+
+  it("a profile stored with a trailing slash is still found, and a row with only the profile creates a person", async () => {
+    const { db, t } = fakeDb();
+    await ingestLead(db, ctx, lead({ Empresa: "Acme Demo", "URL del perfil": "https://www.linkedin.com/in/zed" }));
+    t.people[0].linkedin_url = "https://www.linkedin.com/in/zed/";
+    await ingestLead(db, ctx, lead({ Empresa: "Acme Demo", "URL del perfil": "https://www.linkedin.com/in/zed" }));
+    expect(t.people).toHaveLength(1);
+  });
+
+  it("the same person at another company gets a lead there; the old lead is not touched", async () => {
+    const { db, t } = fakeDb();
+    const p = { Nombre: "Ana", Apellidos: "Prueba", "URL del perfil": "https://www.linkedin.com/in/ana" };
+    await ingestLead(db, ctx, lead({ ...p, Empresa: "Vieja SL" }));
+    const out = await ingestLead(db, ctx, lead({ ...p, Empresa: "Nueva SL" }));
+    expect(t.accounts).toHaveLength(2);
+    expect(t.leads).toHaveLength(2);
+    expect(out.status).toBe("created");
+    expect(t.leads.find((l) => l.account_id === out.accountId)).toBeTruthy();
+  });
+
+  it("re-importing without a stage does not move the person back to «new»", async () => {
+    const { db, t } = fakeDb();
+    const rec = { Empresa: "Acme Demo", Nombre: "Ana", Apellidos: "Prueba", "URL del perfil": "https://www.linkedin.com/in/ana" };
+    await ingestLead(db, ctx, lead(rec));
+    t.people[0].crm_stage = "won";
+    await ingestLead(db, ctx, lead(rec));
+    expect(t.people[0].crm_stage).toBe("won");
+  });
+});
