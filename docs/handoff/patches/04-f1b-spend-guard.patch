+import { describe, expect, it } from "vitest";
+import { readFileSync } from "node:fs";
+import { TOOLS, executeTool, getTool, runTool, type ToolCtx } from "@/lib/agent/tools";
+import { SPEND, guardSpend, isSpendingTool, recordSpend, spendOf } from "@/lib/agent/spend-guard";
+import { agentMcpTools } from "@/lib/mcp/tools/agent-tools";
+
+const ORG = "org-1";
+type Ins = { table: string; payload: unknown };
+/** Fake client: org_budgets answers the limit, integration_usage answers past rows and records inserts. */
+function fakeDb(limit: number | null, past: number[]) {
+  const inserts: Ins[] = [];
+  const db = {
+    from: (table: string) => {
+      let insert: unknown;
+      const p: any = new Proxy({}, {
+        get: (_t, prop: string) => {
+          if (prop === "then") {
+            return (ok: (v: unknown) => unknown) => {
+              if (insert !== undefined) { inserts.push({ table, payload: insert }); return Promise.resolve({ data: null, error: null }).then(ok); }
+              const data = table === "org_budgets" ? (limit == null ? null : { monthly_limit: limit }) : past.map((cost) => ({ cost }));
+              return Promise.resolve({ data, error: null }).then(ok);
+            };
+          }
+          return (...a: unknown[]) => { if (prop === "insert") insert = a[0]; return p; };
+        },
+      });
+      return p;
+    },
+  } as unknown as ToolCtx["db"];
+  return { db, inserts };
+}
+const ctx = (db: ToolCtx["db"]): ToolCtx => ({ db, orgId: ORG, userId: "u", roles: ["owner"], currency: "EUR" });
+
+describe("spend guard", () => {
+  it("every spending tool exists in the registry and stays a read tool", () => {
+    for (const name of Object.keys(SPEND)) {
+      const t = getTool(name);
+      expect(t, name).toBeTruthy();
+      expect(t!.kind, name).toBe("read");
+    }
+    expect(TOOLS.length).toBeGreaterThan(Object.keys(SPEND).length);
+  });
+
+  it("prices enrich_accounts_table per account and research_account with both sources", () => {
+    expect(spendOf("enrich_accounts_table", { account_ids: ["a", "b", "c", "d"] })!.used[0]!.cost).toBeCloseTo(0.2);
+    expect(spendOf("research_account", {})!.used.map((u) => u.service)).toEqual(["firecrawl", "perplexity"]);
+    expect(spendOf("apollo_find_people", {})).toBeNull();
+  });
+
+  it("lets a call through with no cap, and under the cap", async () => {
+    await expect(guardSpend(ctx(fakeDb(null, [999]).db), spendOf("apollo_find_companies", {})!)).resolves.toBeUndefined();
+    await expect(guardSpend(ctx(fakeDb(10, [1, 2]).db), spendOf("apollo_find_companies", {})!)).resolves.toBeUndefined();
+  });
+
+  it("refuses a call that would pass the monthly cap and says why", async () => {
+    await expect(guardSpend(ctx(fakeDb(10, [9.98]).db), spendOf("apollo_find_companies", {})!)).rejects.toThrow(/tope mensual/);
+  });
+
+  it("logs the approximate spend of a call as manual usage for the org", async () => {
+    const { db, inserts } = fakeDb(null, []);
+    await recordSpend(ctx(db), spendOf("clay_enrich_account", {})!);
+    expect(inserts).toHaveLength(1);
+    expect(inserts[0]!.table).toBe("integration_usage");
+    const row = (inserts[0]!.payload as Record<string, unknown>[])[0]!;
+    expect(row).toMatchObject({ org_id: ORG, service: "clay", need: "enrich_account", trigger: "manual", cost: 0.1 });
+  });
+
+  it("executeTool stops a spending tool at the cap before running it", async () => {
+    const { db } = fakeDb(1, [1]);
+    await expect(executeTool(ctx(db), "clay_find_companies", {})).rejects.toThrow(/tope mensual/);
+  });
+
+  it("runTool, the route the chat uses, stops a spending tool at the cap", async () => {
+    const { db } = fakeDb(1, [1]);
+    await expect(runTool(ctx(db), getTool("apollo_find_companies")!, {})).rejects.toThrow(/tope mensual/);
+  });
+
+  it("the in-app and Telegram chat runs read tools through runTool, not tool.run directly", () => {
+    const src = readFileSync(`${process.cwd()}/src/lib/agent/agent.server.ts`, "utf8");
+    expect(src).toContain("runTool(ctx, t, args)");
+    expect(src).not.toMatch(/t\.run\(ctx/);
+  });
+
+  it("MCP no longer calls a spending tool read-only", () => {
+    const hint = (name: string) => (agentMcpTools.find((t) => t.name === name) as unknown as { annotations: { readOnlyHint: boolean } }).annotations.readOnlyHint;
+    expect(isSpendingTool("clay_find_companies")).toBe(true);
+    expect(hint("clay_find_companies")).toBe(false);
+    expect(hint("apollo_find_people")).toBe(true);
+    expect(hint("list_accounts")).toBe(true);
+  });
+});
diff --git a/src/lib/agent/spend-guard.ts b/src/lib/agent/spend-guard.ts
new file mode 100644
index 0000000..d922a75
--- /dev/null
+++ b/src/lib/agent/spend-guard.ts
@@ -0,0 +1,48 @@
+// Tools that return data to the conversation (so they stay `read`) but spend integration credits or save data.
+// The tool layer is where every route meets (chat, Telegram, MCP): here the monthly cap is checked before the call
+// and the approximate spend is logged after it, so the Integraciones meter sees what the chat spends.
+// Costs are the rough per-call EUR figures of the orchestrator catalogue (planner.ts), not billing data.
+import type { Need, Service } from "@/lib/orchestrator/planner";
+import type { ToolCtx } from "./tool-kit";
+
+export type Spend = { need: Need; used: { service: Service; cost: number }[] };
+
+const one = (need: Need, service: Service, cost: number): Spend => ({ need, used: [{ service, cost }] });
+
+/** Spend of one successful call, by tool; apollo_find_people is free and not listed. */
+export const SPEND: Record<string, (args: Record<string, unknown>) => Spend> = {
+  apollo_find_companies: () => one("icp_companies", "apollo", 0.05),
+  apollo_enrich_account: () => one("enrich_account", "apollo", 0.02),
+  clay_find_companies: () => one("icp_companies", "clay", 0.2),
+  clay_find_people: () => one("find_stakeholders", "clay", 0.1),
+  clay_enrich_account: () => one("enrich_account", "clay", 0.1),
+  enrich_accounts_table: (a) => one("enrich_account", "parallel", 0.05 * (Array.isArray(a["account_ids"]) ? a["account_ids"].length : 1)),
+  research_account: () => ({ need: "research_account", used: [{ service: "firecrawl", cost: 0.02 }, { service: "perplexity", cost: 0.01 }] }),
+  company_job_postings: () => one("competitors", "apify", 0.05),
+  competitor_reviews: () => one("competitors", "apify", 0.05),
+  linkedin_company_posts: () => one("news_signals", "apify", 0.05),
+  linkedin_profile_posts: () => one("news_signals", "apify", 0.05),
+};
+
+/** Tools that spend credits (or save data) and so must not be advertised as read-only. */
+export const isSpendingTool = (name: string) => name in SPEND;
+
+export const spendOf = (name: string, args: unknown): Spend | null => SPEND[name]?.((args ?? {}) as Record<string, unknown>) ?? null;
+
+export const eur = (n: number) => n.toFixed(2).replace(".", ",");
+
+/** Refuses a call that would pass the company's monthly cap; with no cap set it lets everything through. */
+export async function guardSpend(c: ToolCtx, spend: Spend) {
+  const { monthBudget } = await import("@/lib/orchestrator/runner");
+  const b = await monthBudget(c);
+  if (b.limit == null) return;
+  const cost = spend.used.reduce((s, u) => s + u.cost, 0);
+  if (b.spent + cost > b.limit) {
+    throw new Error(`Has llegado al tope mensual de integraciones (${eur(b.spent)} € de ${eur(b.limit)} €). No he hecho la consulta; el owner puede subir el tope.`);
+  }
+}
+
+export async function recordSpend(c: ToolCtx, spend: Spend) {
+  const { logUsage } = await import("@/lib/orchestrator/runner");
+  await logUsage(c, spend.need, spend.used, "manual");
+}
