+
 export type { AgentTool, ToolCtx } from "./tool-kit";

 const CORE_TOOLS: AgentTool[] = [...CORE_READ_TOOLS, ...CORE_WRITE_TOOLS, ...STRATEGY_TOOLS, ...FIELD_ACTION_TOOLS, ...CYCLE_TOOLS];
@@ -38,13 +40,26 @@ export function toolsFor(roles: string[]) {
   return TOOLS.filter((t) => canUseTool(t, roles));
 }

+/**
+ * Runs a tool that is already validated and allowed. Every route that executes a read tool goes through here (the chat
+ * in the app and Telegram, MCP, confirmed actions): a spending tool (spend-guard.ts) is checked against the monthly/daily
+ * cap first and its approximate spend is logged after. The cap is soft: concurrent calls read the same total.
+ */
+export async function runTool(ctx: ToolCtx, tool: AgentTool, args: unknown) {
+  const spend = spendOf(tool.name, args);
+  if (spend) await guardSpend(ctx, spend);
+  const result = await tool.run(ctx, args as never);
+  // Only a call that went through is logged; a failure (not connected, provider error) costs nothing here.
+  if (spend) await recordSpend(ctx, spend).catch((e) => console.error("recordSpend failed", (e as Error).message));
+  return result;
+}
+
 /** Validates args and runs a tool after checking role permissions. */
 export async function executeTool(ctx: ToolCtx, name: string, rawArgs: unknown) {
   const tool = getTool(name);
   if (!tool) throw new Error(`Acción desconocida: ${name}`);
   if (!canUseTool(tool, ctx.roles)) throw new Error("Tu rol no permite esta acción");
-  const args = tool.input.parse(rawArgs ?? {});
-  return tool.run(ctx, args);
+  return runTool(ctx, tool, tool.input.parse(rawArgs ?? {}));
 }

