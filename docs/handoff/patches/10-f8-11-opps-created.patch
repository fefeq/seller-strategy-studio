Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Created = deals created this quarter; the bracket now counts those same
deals that are still open, instead of open deals by closing date.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013oUyrHdHaQ4SjMaiyKsvHA
---
 src/components/segment-coverage.tsx |  2 +-
 src/lib/segment-coverage.test.ts    | 11 +++++++++++
 src/lib/segment-coverage.ts         |  7 +++++--
 3 files changed, 17 insertions(+), 3 deletions(-)

diff --git a/src/components/segment-coverage.tsx b/src/components/segment-coverage.tsx
index 93a06c6..8a5ad85 100644
--- a/src/components/segment-coverage.tsx
+++ b/src/components/segment-coverage.tsx
@@ -106,7 +106,7 @@ function SegmentCard({ r, money, canEdit, quarter, onTarget }: { r: SegmentCover
       <div className="mt-3 space-y-2">
         <Metric label="Pipeline abierto" real={money(r.pipeline)} target={r.target ? money(r.target * 3) + " (3x)" : null} progress={r.target ? r.pipeline / (r.target * 3) : null} />
         <Metric label="Deals ganados" real={`${r.won.deals} · ${money(r.won.amount)}`} target={r.won.target != null ? `${r.won.target} deals` : null} progress={r.won.target ? r.won.deals / r.won.target : null} hint={r.won.attainment != null ? `${pct(r.won.attainment)} del objetivo` : undefined} />
-        <Metric label="Oportunidades creadas" real={`${r.opps.created} (${r.opps.open} abiertas)`} target={r.opps.target != null ? `${r.opps.target}` : null} progress={r.opps.target ? r.opps.created / r.opps.target : null} hint={r.opps.target == null && r.target ? "Falta win rate objetivo" : undefined} />
+        <Metric label="Oportunidades creadas" real={`${r.opps.created} (${r.opps.createdStillOpen === 1 ? "1 sigue abierta" : `${r.opps.createdStillOpen} siguen abiertas`})`} target={r.opps.target != null ? `${r.opps.target}` : null} progress={r.opps.target ? r.opps.created / r.opps.target : null} hint={r.opps.target == null && r.target ? "Falta win rate objetivo" : undefined} />
         <Metric label="Win rate" real={r.winRate.real != null ? pct(r.winRate.real) : "—"} target={r.winRate.target != null ? `${r.winRate.target}%` : null} progress={r.winRate.real != null && r.winRate.target ? r.winRate.real / (r.winRate.target / 100) : null} />
         <div className="flex items-center justify-between gap-2 border-t pt-2 text-sm">
           <span>CAC</span>
diff --git a/src/lib/segment-coverage.test.ts b/src/lib/segment-coverage.test.ts
index 00b081d..bd804e4 100644
--- a/src/lib/segment-coverage.test.ts
+++ b/src/lib/segment-coverage.test.ts
@@ -23,6 +23,17 @@ describe("segment coverage", () => {
     expect(row.opps.target).toBe(20);
     expect(row.won.attainment).toBeCloseTo(0.2);
   });
+  it("opportunities created counts this quarter's new deals; «still open» is about those same deals", () => {
+    const deals = [
+      d({ segment_id: "mid", stage: "won", closed_at: "2026-10-20" }), // created and already won
+      d({ segment_id: "mid", close_date: null }), // created, open, no closing date
+      d({ segment_id: "mid", created_at: "2026-06-01" }), // older deal closing this quarter
+    ];
+    const [row] = segmentCoverage([mid], deals, {}, range);
+    expect(row.opps.created).toBe(2);
+    expect(row.opps.createdStillOpen).toBe(1);
+    expect(row.opps.open).toBe(1); // by closing date: only the older one
+  });
   it("payback = CAC / (ACV × margin / 12) compared with the segment target", () => {
     const deals = [d({ amount: 20000, stage: "won", segment_id: "mid", closed_at: "2026-10-20" })];
     const [row] = segmentCoverage([mid], deals, {}, range);
diff --git a/src/lib/segment-coverage.ts b/src/lib/segment-coverage.ts
index d66a56c..de18110 100644
--- a/src/lib/segment-coverage.ts
+++ b/src/lib/segment-coverage.ts
@@ -44,7 +44,10 @@ export function segmentCoverage(segments: SegLike[], deals: DealLike[], targets:
     const closed = ds.filter((d) => (d.stage === "won" || d.stage === "lost") && inQ(d.closed_at ?? d.updated_at));
     const wonQ = closed.filter((d) => d.stage === "won");
     const wonAmount = wonQ.reduce((s, d) => s + Number(d.amount ?? 0), 0);
-    const created = ds.filter((d) => inQ(d.created_at)).length;
+    const createdDeals = ds.filter((d) => inQ(d.created_at));
+    const created = createdDeals.length;
+    // Of those created this quarter, the ones still open now: «open» above counts by closing date, a different group.
+    const createdStillOpen = createdDeals.filter((d) => d.stage !== "won" && d.stage !== "lost").length;
     const winTarget = seg.win_rate_target ? Number(seg.win_rate_target) : null;
     const dealsTarget = target && acv ? Math.ceil(target / acv) : null;
     const oppsTarget = dealsTarget != null && winTarget ? Math.ceil(dealsTarget / (winTarget / 100)) : null;
@@ -61,7 +64,7 @@ export function segmentCoverage(segments: SegLike[], deals: DealLike[], targets:
       pipeline,
       coverage: target ? coverage(pipeline, target) : null,
       won: { deals: wonQ.length, amount: wonAmount, target: dealsTarget, attainment: target ? wonAmount / target : null },
-      opps: { created, open: open.length, target: oppsTarget },
+      opps: { created, createdStillOpen, open: open.length, target: oppsTarget },
       winRate: { real: closed.length ? realWin : null, target: winTarget },
       cac: { ...cac, real: cac.cac, target: cacTarget },
       payback: { real: payback, source: paybackSource, target: seg.payback_months != null ? Number(seg.payback_months) : null, ok: payback != null && seg.payback_months != null ? payback <= Number(seg.payback_months) : null },
