index 34fc707..1880339 100644
--- a/src/lib/money.ts
+++ b/src/lib/money.ts
@@ -13,12 +13,17 @@ export const CURRENCIES: Record<string, string> = {
   CAD: "Dólar canadiense (CAD)",
 };

+// TypeScript's lib still types useGrouping as boolean; the runtime accepts "always".
+const ALWAYS_GROUP = "always" as unknown as boolean;
+
 export function formatMoney(n: number, currency = "EUR", compact = false) {
   return new Intl.NumberFormat("es-ES", {
     style: "currency",
     currency,
     maximumFractionDigits: compact ? 1 : 0,
     notation: compact ? "compact" : "standard",
+    // es-ES leaves 4-digit numbers without a separator («1234 €») unless asked: «1.234 €» everywhere.
+    useGrouping: ALWAYS_GROUP,
   }).format(n);
 }

@@ -28,3 +33,6 @@ export function currencySymbol(currency = "EUR") {

 /** A 0–1 ratio as a whole percentage («0.123» → «12%»). The one percentage format for screens. */
 export const pct = (ratio: number) => `${Math.round(ratio * 100)}%`;
+
+/** A plain number the Spanish way, with thousands separator also from 1.000 («1.234,5»). */
+export const formatNumber = (n: number, maxDecimals = 1) => n.toLocaleString("es-ES", { maximumFractionDigits: maxDecimals, useGrouping: ALWAYS_GROUP });
