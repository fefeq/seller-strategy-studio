diff --git a/src/lib/money.test.ts b/src/lib/money.test.ts
new file mode 100644
index 0000000..a843aaa
--- /dev/null
+++ b/src/lib/money.test.ts
@@ -0,0 +1,19 @@
+import { describe, expect, it } from "vitest";
+import { formatMoney, formatNumber } from "./money";
+
+// Intl uses a no-break space before «€»; compare without caring which space.
+const flat = (s: string) => s.replace(/\s/g, " ");
+
+describe("number formats", () => {
+  it("puts the thousands separator from 1.000, not only from 10.000", () => {
+    expect(formatNumber(1234, 0)).toBe("1.234");
+    expect(flat(formatMoney(1234))).toBe("1.234 €");
+    expect(flat(formatMoney(12345))).toBe("12.345 €");
+  });
+
+  it("uses a decimal comma and caps the decimals", () => {
+    expect(formatNumber(1234.56)).toBe("1.234,6");
+    expect(formatNumber(3.14159, 2)).toBe("3,14");
+    expect(formatNumber(2, 1)).toBe("2");
+  });
+});
