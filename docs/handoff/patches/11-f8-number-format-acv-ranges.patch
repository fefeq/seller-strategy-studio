diff --git a/src/lib/segment-fields.ts b/src/lib/segment-fields.ts
index 99054b5..fdf8228 100644
--- a/src/lib/segment-fields.ts
+++ b/src/lib/segment-fields.ts
@@ -1,3 +1,4 @@
+import { formatNumber } from "@/lib/money";
 // Validation of the numeric benchmarks a person types in the segment table. Pure so the table can
 // refuse a bad value before it reaches the database and say which field and why, instead of
 // the generic «algún valor no tiene el formato correcto».
@@ -70,3 +71,26 @@ export function checkAcvRange(
   if (min == null || max == null || Number(min) <= Number(max)) return null;
   return `El ACV mín${segmentName ? ` de «${segmentName}»` : ""} es mayor que el ACV máx. Corrige uno de los dos.`;
 }
+
+/**
+ * Overlaps and gaps between the ACV ranges of the segments that have both ends. An overlap makes the
+ * automatic segment ambiguous (the segment with the higher minimum wins); a gap leaves deals in between with no segment.
+ * Ranges that touch (one max equal to the next min) are fine. Returns plain sentences for the screen.
+ */
+export function acvRangeIssues(segs: { name: string; acv_min: number | null; acv_max: number | null }[]): string[] {
+  const rs = segs
+    .filter((s) => s.acv_min != null && s.acv_max != null && Number(s.acv_min) <= Number(s.acv_max))
+    .map((s) => ({ name: s.name, min: Number(s.acv_min), max: Number(s.acv_max) }))
+    .sort((a, b) => a.min - b.min || a.max - b.max);
+  const fmt = (n: number) => formatNumber(n, 0);
+  const out: string[] = [];
+  // Compared with the highest ceiling seen so far, not only the neighbour: a wide range that contains a
+  // small one must not read as a gap after it.
+  let top = rs[0];
+  for (const cur of rs.slice(1)) {
+    if (cur.min < top.max) out.push(`Los rangos de ACV de «${top.name}» y «${cur.name}» se solapan: un deal entre ${fmt(cur.min)} y ${fmt(Math.min(cur.max, top.max))} cabe en los dos.`);
+    else if (cur.min > top.max) out.push(`Entre «${top.name}» (hasta ${fmt(top.max)}) y «${cur.name}» (desde ${fmt(cur.min)}) hay un hueco: esos deals no encajan en ningún segmento.`);
+    if (cur.max > top.max) top = cur;
+  }
+  return out;
+}
