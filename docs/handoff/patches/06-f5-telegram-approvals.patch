diff --git a/src/lib/approvals-guard.pg.test.ts b/src/lib/approvals-guard.pg.test.ts
new file mode 100644
index 0000000..573d1bb
--- /dev/null
+++ b/src/lib/approvals-guard.pg.test.ts
@@ -0,0 +1,89 @@
+// @vitest-environment node
+// Runs migration 0064 (guard_approval with a privileged path) on an in-process Postgres: the function from 0002 first,
+// then the new one, with two fictional companies. See src/test/pg-harness.ts for what it models.
+import { readFileSync } from "node:fs";
+import { beforeAll, describe, expect, it } from "vitest";
+import { REPO, as, build, migrate, seed, U } from "@/test/pg-harness";
+
+type Db = Awaited<ReturnType<typeof build>>;
+let db: Db;
+let A: string;
+let B: string;
+const SALES_A = "00000000-0000-4000-8000-0000000000a3";
+const rows = async (sql: string, params?: unknown[]) => (await db.query(sql, params)).rows as Record<string, any>[];
+const throws = async (fn: () => Promise<unknown>) => { try { await fn(); return ""; } catch (e) { return String((e as Error).message); } };
+const newApproval = async (org: string) => (await rows("insert into approvals (org_id, kind, title) values ($1, 'other', 'x') returning id", [org]))[0]!.id as string;
+const state = async (id: string) => (await rows("select status, decided_by from approvals where id = $1", [id]))[0]!;
+
+beforeAll(async () => {
+  db = await build();
+  ({ A, B } = await seed(db));
+  await db.exec(`insert into org_members (org_id, user_id, role) values ('${A}','${SALES_A}','sales_leader')`);
+  // Supabase gives service_role every privilege on public tables (the harness creates org_members before its default privileges).
+  await db.exec("grant all on public.org_members to service_role");
+  await db.exec(`create table public.approvals (id uuid primary key default gen_random_uuid(), org_id uuid, kind text not null, title text not null, evidence text default '', status text not null default 'pending', decided_by uuid, created_by uuid, updated_by uuid, created_at timestamptz not null default now(), updated_at timestamptz not null default now());
+    grant all on public.approvals to authenticated, service_role;`);
+  // The function as 0002 left it (what production runs today), then the trigger and migration 0064.
+  const m2 = readFileSync(`${REPO}/drizzle/migrations/0002_multitenant_organizations.sql`, "utf8");
+  const old = m2.slice(m2.indexOf("create or replace function public.guard_approval()"), m2.indexOf("-- 7. Create organization"));
+  await db.exec(old);
+  await db.exec("create trigger approvals_guard before update on public.approvals for each row execute function public.guard_approval()");
+}, 60_000);
+
+describe("guard_approval before 0064 (the gap)", () => {
+  it("a service-role decision is refused, as Telegram saw", async () => {
+    const id = await newApproval(A);
+    expect(await as(db, null, () => throws(() => db.query("update approvals set status = 'applied', decided_by = $2 where id = $1", [id, U.ownerA])))).toMatch(/Solo owner/);
+  });
+});
+
+describe("migration 0064: guard_approval with a privileged path", () => {
+  beforeAll(async () => { await migrate(db, ["0064_guard_approval_privileged_path.sql"]); });
+
+  it("a signed-in owner or sales leader still decides, and decided_by is forced to them", async () => {
+    const id = await newApproval(A);
+    await as(db, SALES_A, async () => { await db.query("update approvals set status = 'applied', decided_by = $2 where id = $1", [id, U.ownerA]); });
+    expect(await state(id)).toMatchObject({ status: "applied", decided_by: SALES_A });
+  });
+
+  it("a signed-in member without an approver role is refused", async () => {
+    const id = await newApproval(A);
+    expect(await as(db, U.aeA, () => throws(() => db.query("update approvals set status = 'applied' where id = $1", [id])))).toMatch(/Solo owner/);
+    expect((await state(id)).status).toBe("pending");
+  });
+
+  it("the service role decides when it names an approver of the approval's company", async () => {
+    const id = await newApproval(A);
+    await as(db, null, async () => { await db.query("update approvals set status = 'skipped', decided_by = $2 where id = $1", [id, SALES_A]); });
+    expect(await state(id)).toMatchObject({ status: "skipped", decided_by: SALES_A });
+  });
+
+  it("the service role is refused without a decider, or with one who cannot decide or belongs to another company", async () => {
+    const id = await newApproval(A);
+    const decide = (who: string | null) => as(db, null, () => throws(() => db.query("update approvals set status = 'applied', decided_by = $2 where id = $1", [id, who])));
+    expect(await decide(null)).toMatch(/Solo owner/);
+    expect(await decide(U.aeA)).toMatch(/Solo owner/);
+    expect(await decide(U.ownerB)).toMatch(/Solo owner/);
+    expect(await decide("00000000-0000-4000-8000-00000000ffff")).toMatch(/Solo owner/);
+    expect((await state(id)).status).toBe("pending");
+  });
+
+  it("an approver of company B cannot decide company A's approval through the service role", async () => {
+    const id = await newApproval(A);
+    expect(await as(db, null, () => throws(() => db.query("update approvals set status = 'applied', decided_by = $2 where id = $1", [id, U.ownerB])))).toMatch(/Solo owner/);
+    const idB = await newApproval(B);
+    await as(db, null, async () => { await db.query("update approvals set status = 'applied', decided_by = $2 where id = $1", [idB, U.ownerB]); });
+    expect((await state(idB)).status).toBe("applied");
+  });
+
+  it("the anon role and updates that do not change the status are not affected", async () => {
+    const id = await newApproval(A);
+    await db.exec("set role anon");
+    const anon = await throws(() => db.query("update approvals set status = 'applied' where id = $1", [id]));
+    await db.exec("reset role");
+    expect(anon).toBeTruthy();
+    expect((await state(id)).status).toBe("pending");
+    await as(db, U.aeA, async () => { await db.query("update approvals set title = 'y' where id = $1", [id]); });
+    expect((await rows("select title from approvals where id = $1", [id]))[0]!.title).toBe("y");
+  });
+});
