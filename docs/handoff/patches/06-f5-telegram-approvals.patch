diff --git a/drizzle/migrations/0064_guard_approval_privileged_path.sql b/drizzle/migrations/0064_guard_approval_privileged_path.sql
new file mode 100644
index 0000000..8c59740
--- /dev/null
+++ b/drizzle/migrations/0064_guard_approval_privileged_path.sql
@@ -0,0 +1,29 @@
+-- decide_approval failed from Telegram: guard_approval (0002) reads auth.uid(), which is NULL for the privileged client
+-- (service role) that Telegram and cron use, so every decision raised «Solo owner, sales leader o deal desk…».
+-- A signed-in user is checked exactly as before. The service role may now decide only when the row names WHO decides
+-- (decided_by) and that person is an owner, sales_leader or deal_desk member of THIS approval's company: the app code
+-- already checks the role of the Telegram-linked user, and the database now checks it too and keeps the audit trail.
+-- Anyone else (anon, or authenticated with no uid) is refused. Verified locally in approvals-guard.pg.test.ts.
+
+CREATE OR REPLACE FUNCTION public.guard_approval()
+RETURNS trigger LANGUAGE plpgsql SET search_path = public AS $$
+BEGIN
+  IF new.status <> old.status THEN
+    IF auth.uid() IS NOT NULL THEN
+      IF NOT (public.has_org_role(new.org_id,'owner') OR public.has_org_role(new.org_id,'sales_leader') OR public.has_org_role(new.org_id,'deal_desk')) THEN
+        RAISE EXCEPTION 'Solo owner, sales leader o deal desk pueden decidir aprobaciones';
+      END IF;
+      new.decided_by := auth.uid();
+    ELSIF current_user = 'service_role' THEN
+      IF new.decided_by IS NULL OR NOT EXISTS (
+        SELECT 1 FROM public.org_members m
+        WHERE m.org_id = new.org_id AND m.user_id = new.decided_by AND m.role IN ('owner','sales_leader','deal_desk')
+      ) THEN
+        RAISE EXCEPTION 'Solo owner, sales leader o deal desk pueden decidir aprobaciones';
+      END IF;
+    ELSE
+      RAISE EXCEPTION 'Solo owner, sales leader o deal desk pueden decidir aprobaciones';
+    END IF;
+  END IF;
+  RETURN new;
+END $$;
